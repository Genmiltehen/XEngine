{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/XEngine.slnx",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "pack: XEngine.Core",
			"command": "dotnet",
			"type": "process",
			"args": [
				"pack",
				"${workspaceFolder}/src/XEngine.Core/XEngine.Core.csproj",
				"-c",
				"${input:selectPackType}",
				"-o",
				"${env:NUGET_LOCAL}"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "pack: all",
			"command": "dotnet",
			"type": "process",
			"args": [
				"pack",
				"${workspaceFolder}/XEngine.slnx",
				"-c",
				"${input:selectPackType}",
				"-o",
				"${env:NUGET_LOCAL}"
			],
			"problemMatcher": "$msCompile"
		}
	],
	"inputs": [
		{
			"id": "selectPackType",
			"type": "pickString",
			"description": "pack type:",
			"options": [
				"Release",
				"Debug"
			],
			"default": "development"
		}
	]
}